# Frontend Configuration
# Backend base URL for local development and Docker builds
VITE_BACKEND_URL=http://localhost:55555

# Dify base URL — must be reachable from the browser (not host.docker.internal)
# Used for direct chat-message calls: <VITE_DIFY_API_BASE_URL>/v1/chat-messages
VITE_DIFY_API_BASE_URL=http://localhost

# Optional: override the full chat endpoint directly
# VITE_DIFY_CHAT_ENDPOINT=http://192.168.8.162/v1/chat-messages

# Dify chatbot API key (used as Bearer token for chat-message requests)
VITE_BACKEND_CHATBOT_KEY=app-uGddKkgTyZuvPWdkMh0VeiMQ

VITE_DIFY_USER_ID=testuser

# Optional keys for real backend integration.
# Leave empty to use mock mode.
VITE_BACKEND_WORKFLOW_KEY=
